<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve authorization headers for Laravel API and admin requests.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Laravel remains responsible for the API, admin panel and health check.
    RewriteRule ^(?:api|admin|up)(?:/.*)?$ index.php [L]

    # The React application owns the site root.
    RewriteRule ^$ index.html [L]

    # Serve existing assets and files directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback for the React application.
    RewriteRule . index.html [L]
</IfModule>
